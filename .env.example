# Only needed for --live. Paper mode and monitoring use public endpoints and need no keys.
# Create a dedicated API key: Enable Spot & Margin Trading + Enable Futures. NEVER enable withdrawals.
# Restrict it to your IP address.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Testnet only (--testnet). Binance's spot and futures testnets are two separate exchanges with separate keys:
# futures keys from https://testnet.binancefuture.com, spot keys from https://testnet.binance.vision.
# Each falls back to BINANCE_API_KEY / BINANCE_API_SECRET when left empty. Verify with: run.py --check --testnet
BINANCE_TESTNET_FUTURES_API_KEY=
BINANCE_TESTNET_FUTURES_API_SECRET=
BINANCE_TESTNET_SPOT_API_KEY=
BINANCE_TESTNET_SPOT_API_SECRET=

# Telegram alerts (optional). 1) Message @BotFather, /newbot, copy the token here.
# 2) Open your new bot in Telegram and press Start. 3) Run: .venv/bin/python run.py --find-chat-id
# 4) Put the chat id below, then verify with: .venv/bin/python run.py --test-alert
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hosted read-only dashboard (optional): the Upstash Redis REST URL and its READ-WRITE token (this machine only).
# The Vercel app gets the READ-ONLY token instead. See vercel-dashboard/README.md.
DASHBOARD_PUSH_URL=
DASHBOARD_PUSH_TOKEN=

# Required in addition to --live when trading mainnet with real money:
# ARBBOT_LIVE_ACK=I_UNDERSTAND_THIS_TRADES_REAL_MONEY
