[Desktop Entry]
Type=Application
Name=Stop Binance Bots
Comment=Stop the testnet and mainnet bots
Terminal=true
Icon=process-stop
Exec=bash -c 'd=$(dirname "$1"); d=${d#file://}; cd "$d" 2>/dev/null && [ -f "Stop Binance Bots.command" ] || { echo "Cannot find Stop Binance Bots.command next to this launcher."; read -r -p "Press Enter to close... "; exit 1; }; exec bash "./Stop Binance Bots.command"' _ %k
Categories=Utility;Finance;
