# systemd user service (Linux): the TESTNET bot (test money) exactly as start-bots.sh starts it: arbitrage entries
# start paused, the swing kit trades on the futures testnet demo account, dashboard on port 8767 (+ phone link with
# --lan). Restarted if it crashes. Needs the testnet keys in .env.
# There is deliberately no service for the MAINNET bot: real money only starts by hand (start-bots.sh, which asks
# you to type TRADE REAL MONEY). When the mainnet bot runs, it answers the Telegram commands, so add --no-commands
# below (only one bot per Telegram token may poll for commands).
# Install / remove: see "Running 24/7 (Linux systemd)" in README.md. %h is your home folder.
[Unit]
Description=binance-arb-bot (testnet)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/binance-arb-bot
Environment=DASHBOARD_PUSH_URL= DASHBOARD_PUSH_TOKEN=
ExecStart=%h/binance-arb-bot/.venv/bin/python run.py --live --testnet --config config.testnet.toml --min-samples 20 \
    --swing --swing-mirror trend,swing,smc --swing-mirror-copy-open --lan
Restart=on-failure
RestartSec=15
StandardOutput=append:%h/binance-arb-bot/logs/testnet-bot.out
StandardError=append:%h/binance-arb-bot/logs/testnet-bot.out

[Install]
WantedBy=default.target
