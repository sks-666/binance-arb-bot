[Desktop Entry]
Type=Application
Name=Start Binance Bots
Comment=Start the testnet bot (and the mainnet bot if you confirm)
Terminal=true
Icon=utilities-terminal
Exec=bash -c 'd=$(dirname "$1"); d=${d#file://}; cd "$d" 2>/dev/null && [ -f "Start Binance Bots.command" ] || { echo "Cannot find Start Binance Bots.command next to this launcher."; read -r -p "Press Enter to close... "; exit 1; }; exec bash "./Start Binance Bots.command"' _ %k
Categories=Utility;Finance;
